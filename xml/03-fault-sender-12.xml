
<?xml version="1.0" encoding="UTF-8"?>

<soap:Envelope
    xmlns:soap="http://www.w3.org/2003/05/soap-envelope">

    <soap:Body>
        <soap:Fault>

            <soap:Code>
                <soap:Value>soap:Sender</soap:Value>
            </soap:Code>

            <soap:Reason>
                <soap:Text xml:lang="fr">
                    ISBN mal formé : 978-2-10
                </soap:Text>
            </soap:Reason>

            <soap:Detail>
                <message>Format ISBN incorrect</message>
            </soap:Detail>

        </soap:Fault>
    </soap:Body>

</soap:Envelope>
